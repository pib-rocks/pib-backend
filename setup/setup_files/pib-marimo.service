[Unit]
Description=pib Marimo Reactive Python Notebook Server
After=network.target

[Service]
Type=simple
User=pib
WorkingDirectory=/home/pib/programs/notebooks
ExecStart=/usr/bin/python3 -m marimo edit --host 0.0.0.0 --port 2718 --no-token --headless
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
