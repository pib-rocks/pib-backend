[Unit]
Description=pib host-side software update availability check
After=network-online.target
Before=pib-update.service
Wants=network-online.target
ConditionPathExists=/home/pib/app/.update/check.json

[Service]
Type=oneshot
User=pib
Group=pib
WorkingDirectory=/home/pib/app/pib-backend
Environment=PIB_UPDATE_DIR=/home/pib/app/.update
ExecStart=/home/pib/app/pib-backend/setup/update_runner.sh --check
UMask=0007
StandardOutput=journal
StandardError=journal
