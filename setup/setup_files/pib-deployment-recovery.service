[Unit]
Description=Recreate missing PIB Compose services from local images
After=docker.service pib-voice-hermes-view.service
Requires=docker.service
Wants=pib-voice-hermes-view.service

[Service]
Type=oneshot
User=pib
Group=pib
WorkingDirectory=/home/pib/app/pib-backend
Environment=PIB_UPDATE_DIR=/home/pib/app/.update
ExecStart=/usr/bin/python3 /home/pib/app/.update/deployment_recovery.py recover
UMask=0007
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
