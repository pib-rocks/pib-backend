[Unit]
Description=Restore checked voice policy before Docker starts workloads
DefaultDependencies=no
After=local-fs.target
Before=docker.service
RequiresMountsFor=/home/pib/app/pib-backend /var/lib/pib-voice-egress

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PIB_BACKEND_DIR=/home/pib/app/pib-backend
ExecStart=/bin/bash -c 'exec /bin/bash "${PIB_BACKEND_DIR:-/home/pib/app/pib-backend}/setup/voice_egress/apply.sh" restore'
