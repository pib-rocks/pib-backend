[Unit]
Description=Publish the filtered Hermes view for the voice container
Before=docker.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PIB_BACKEND_DIR=/home/pib/app/pib-backend
ExecStart=/bin/bash -c 'exec /bin/bash "${PIB_BACKEND_DIR:-/home/pib/app/pib-backend}/setup/voice_egress/apply.sh" prepare-view'
ExecStop=/bin/bash -c 'exec /bin/bash "${PIB_BACKEND_DIR:-/home/pib/app/pib-backend}/setup/voice_egress/apply.sh" remove-view'

[Install]
WantedBy=docker.service
